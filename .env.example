# 阿里云百炼 DashScope OpenAI-compatible API. 未配置 API Key 时自动使用 mock。
PORT=3000
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-turbo

# 可选：接入文献/专利 embedding 检索服务。需返回 {"keywords":[...]}。
KEYWORD_RETRIEVAL_URL=

# 可选：第二个 OpenAI-compatible 生成模型，用于多模型候选融合。
SECONDARY_AI_API_KEY=
SECONDARY_AI_BASE_URL=
SECONDARY_AI_MODEL=
